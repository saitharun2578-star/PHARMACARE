# Database Configuration
# Set DB_TYPE to 'mysql' (default) or 'sqlite' for quick offline dev / automated testing
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacare
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# For SQLite mode (used automatically if MySQL credentials are not provided or in testing)
SQLITE_DB_PATH=pharmacare.db

# Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-pharmacare-secure
